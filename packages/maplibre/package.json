{
  "name": "@pholidlabs/chronomap-maplibre",
  "version": "0.1.0",
  "description": "MapLibre GL renderer for ChronoMap campaigns: parchment basemap, campaign layers, chapter cameras",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PholidLabs/chronomaps.git",
    "directory": "packages/maplibre"
  },
  "homepage": "https://github.com/PholidLabs/chronomaps/tree/main/packages/maplibre#readme",
  "bugs": "https://github.com/PholidLabs/chronomaps/issues",
  "keywords": [
    "chronomap",
    "maplibre",
    "historical-maps",
    "timeline",
    "storytelling"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/chronomap.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.0.0"
  },
  "dependencies": {
    "@pholidlabs/chronomap-engine": "0.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^6.10.0",
    "typescript": "^5.9.2"
  }
}
