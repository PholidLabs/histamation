{
  "name": "@chronomap/engine",
  "version": "0.1.0",
  "description": "ChronoMap contract engine: parse, validate and resolve campaign files (reference implementation for the Rust/WASM core)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "bin": {
    "chronomap-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.2"
  }
}
